# 복사해서 .env.local 로 저장 후 값 입력 (VITE_ 접두사 없음 → 브라우저에 노출되지 않음)

# YouTube Data API v3 키 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# 국립중앙도서관 Open API 인증키 — https://www.nl.go.kr/NL/contents/N31101010000.do
NL_API_KEY=

# ChatDDS(창조과학 AI 챗봇) 서버 키 — ChatDDS 운영자에게 별도 전달받음
CHATDDS_API_KEY=
